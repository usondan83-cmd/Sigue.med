<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ================================================= -->
    <!-- TÍTULO -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/textoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💊 Registrar medicamento"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="25dp"/>


    <!-- ================================================= -->
    <!-- NOMBRE DEL MEDICAMENTO -->
    <!-- ================================================= -->

    <EditText
        android:id="@+id/editNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del medicamento"
        android:inputType="text"
        android:textSize="18sp"
        android:padding="12dp"/>


    <!-- ================================================= -->
    <!-- DOSIS -->
    <!-- ================================================= -->

    <EditText
        android:id="@+id/editDosis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="Dosis"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:padding="12dp"/>

    <!-- ================================================= -->
    <!-- FECHA DE INICIO -->
    <!-- ================================================= -->

    <EditText
        android:id="@+id/editFechaInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="Fecha de inicio"
        android:focusable="false"
        android:clickable="true"
        android:textSize="18sp"
        android:padding="12dp"/>
    <!-- ================================================= -->
    <!-- UNIDAD -->
    <!-- ================================================= -->

    <Spinner
        android:id="@+id/spinnerUnidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"/>


    <!-- ================================================= -->
    <!-- FRECUENCIA -->
    <!-- ================================================= -->

    <Spinner
        android:id="@+id/spinnerFrecuencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"/>


    <!-- ================================================= -->
    <!-- HORA DE INICIO -->
    <!-- ================================================= -->

    <EditText
        android:id="@+id/editHoraInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="Hora de inicio"
        android:focusable="false"
        android:clickable="true"
        android:textSize="18sp"
        android:padding="12dp"/>


    <!-- ================================================= -->
    <!-- DÍAS DE TRATAMIENTO -->
    <!-- ================================================= -->

    <EditText
        android:id="@+id/editDiasTratamiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="Días de tratamiento"
        android:inputType="number"
        android:textSize="18sp"
        android:padding="12dp"/>


    <!-- ================================================= -->
    <!-- BOTÓN GUARDAR -->
    <!-- ================================================= -->

    <Button
        android:id="@+id/botonGuardar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Guardar medicamento"
        android:textSize="18sp"/>

</LinearLayout>

